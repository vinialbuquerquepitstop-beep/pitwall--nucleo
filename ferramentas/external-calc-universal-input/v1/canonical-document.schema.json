{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "external-calc/canonical-document/v1",
  "title": "External Calc CanonicalDocument V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_id",
    "source",
    "parser",
    "blocks",
    "metadata",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "filename", "content_hash"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "filename": { "type": "string", "minLength": 1 },
        "mime_type": { "type": ["string", "null"] },
        "content_ref": { "type": ["string", "null"] },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "version"],
      "properties": {
        "adapter": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "metadata": {
      "type": "object"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    }
  },
  "$defs": {
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cell_id", "column", "raw"],
      "properties": {
        "cell_id": { "type": "string", "minLength": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "raw": {}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "sheet", "row", "source_ref"],
      "properties": {
        "page": { "type": ["integer", "null"], "minimum": 1 },
        "sheet": { "type": ["string", "null"] },
        "row": { "type": ["integer", "null"], "minimum": 1 },
        "source_ref": { "type": "string", "minLength": 1 }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_id", "index", "type", "text", "provenance"],
      "properties": {
        "block_id": { "type": "string", "minLength": 1 },
        "index": { "type": "integer", "minimum": 0 },
        "type": {
          "enum": [
            "text",
            "row",
            "table",
            "heading",
            "list_item",
            "image_region",
            "unknown"
          ]
        },
        "text": { "type": "string" },
        "cells": {
          "type": "array",
          "items": { "$ref": "#/$defs/cell" }
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    }
  }
}
