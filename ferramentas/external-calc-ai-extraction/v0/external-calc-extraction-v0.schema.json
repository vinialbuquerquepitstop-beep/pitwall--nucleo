{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:external-calc:extraction:v0",
  "title": "External Calc Portable AI Extraction V0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sources",
    "offers",
    "unresolved",
    "coverage"
  ],
  "properties": {
    "schema_version": {
      "const": "external-calc-extraction/v0"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_ref",
          "filename",
          "kind",
          "text"
        ],
        "properties": {
          "source_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "kind": {
            "enum": [
              "TEXT",
              "MESSAGE",
              "ZIP_ENTRY",
              "CSV"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200000
          }
        }
      }
    },
    "offers": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "offer_ref",
          "raw_model",
          "brand",
          "model",
          "capacity_gb",
          "color",
          "condition",
          "price",
          "supplier_ref",
          "source_refs",
          "field_evidence",
          "extraction_confidence",
          "issues"
        ],
        "properties": {
          "offer_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "raw_model": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 500
          },
          "brand": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 500
          },
          "model": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 500
          },
          "capacity_gb": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "color": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 500
          },
          "condition": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 500
          },
          "price": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "amount_minor",
              "currency"
            ],
            "properties": {
              "amount_minor": {
                "type": "integer",
                "minimum": 1
              },
              "currency": {
                "const": "BRL"
              }
            }
          },
          "supplier_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 100
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "field_evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "raw_model",
              "brand",
              "model",
              "capacity_gb",
              "color",
              "condition",
              "price",
              "supplier_ref"
            ],
            "properties": {
              "raw_model": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source_ref",
                    "quote"
                  ],
                  "properties": {
                    "source_ref": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  }
                }
              },
              "brand": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source_ref",
                    "quote"
                  ],
                  "properties": {
                    "source_ref": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  }
                }
              },
              "model": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source_ref",
                    "quote"
                  ],
                  "properties": {
                    "source_ref": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  }
                }
              },
              "capacity_gb": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source_ref",
                    "quote"
                  ],
                  "properties": {
                    "source_ref": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  }
                }
              },
              "color": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source_ref",
                    "quote"
                  ],
                  "properties": {
                    "source_ref": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  }
                }
              },
              "condition": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source_ref",
                    "quote"
                  ],
                  "properties": {
                    "source_ref": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  }
                }
              },
              "price": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source_ref",
                    "quote"
                  ],
                  "properties": {
                    "source_ref": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  }
                }
              },
              "supplier_ref": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source_ref",
                    "quote"
                  ],
                  "properties": {
                    "source_ref": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  }
                }
              }
            }
          },
          "extraction_confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_ref",
          "reason",
          "quote"
        ],
        "properties": {
          "source_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_items_total",
        "processed_items",
        "unprocessed_items"
      ],
      "properties": {
        "source_items_total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "processed_items": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "unprocessed_items": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
