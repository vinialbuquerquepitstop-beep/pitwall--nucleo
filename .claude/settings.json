{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__supabase__apply_migration"
    ],
    "deny": [
      "Bash(git add -A)",
      "Bash(git add -A:*)",
      "Bash(git add --all)",
      "Bash(git add --all:*)",
      "Bash(git add .)",
      "Bash(git add .:*)",
      "Bash(git add -u)",
      "Bash(git add -u:*)",
